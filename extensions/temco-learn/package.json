{
  "name": "temco-learn",
  "displayName": "Temco Learn",
  "description": "The Temco documentation site: its products, their versions, and the reader a visitor sees.",
  "version": "0.0.1",
  "publisher": "temcocontrols",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/temcocontrols/temco-platform.git"
  },
  "bugs": {
    "url": "https://github.com/temcocontrols/temco-platform/issues"
  },
  "engines": {
    "vscode": "^1.143.0"
  },
  "type": "commonjs",
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onView:temcoLearn.panel"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "temcoLearn",
          "title": "Temco Learn",
          "icon": "$(cloud-upload)"
        }
      ]
    },
    "views": {
      "temcoLearn": [
        {
          "id": "temcoLearn.overviewView",
          "name": "Overview",
          "initialSize": 1
        },
        {
          "id": "temcoLearn.browse",
          "name": "Site",
          "initialSize": 6
        },
        {
          "id": "temcoLearn.download",
          "name": "Build Output",
          "initialSize": 2
        },
        {
          "id": "temcoLearn.todo",
          "name": "To do",
          "initialSize": 3
        }
      ]
    },
    "commands": [
      {
        "command": "temcoLearn.overview",
        "title": "Overview",
        "icon": "$(home)",
        "category": "Temco Learn"
      },
      {
        "command": "temcoLearn.site.preview",
        "title": "Preview the Site",
        "icon": "$(open-preview)",
        "category": "Temco Learn"
      },
      {
        "command": "temcoLearn.site.build",
        "title": "Build the Site",
        "icon": "$(tools)",
        "category": "Temco Learn"
      },
      {
        "command": "temcoLearn.site.install",
        "title": "Install the Site Dependencies",
        "icon": "$(package)",
        "category": "Temco Learn"
      },
      {
        "command": "temcoLearn.site.stop",
        "title": "Stop the Site",
        "icon": "$(debug-stop)",
        "category": "Temco Learn"
      },
      {
        "command": "temcoLearn.site.start",
        "title": "Start the Site",
        "icon": "$(play)",
        "category": "Temco Learn"
      },
      {
        "command": "temcoLearn.site.port",
        "title": "Change the Site's Port",
        "icon": "$(plug)",
        "category": "Temco Learn"
      },
      {
        "command": "temcoLearn.stopArtifact",
        "title": "Stop Serving This Build Output",
        "icon": "$(debug-stop)",
        "category": "Temco Learn"
      },
      {
        "command": "temcoLearn.site.folder",
        "title": "Open the Site Folder",
        "icon": "$(folder-opened)",
        "category": "Temco Learn"
      },
      {
        "command": "temcoLearn.site.page",
        "title": "Open the Site Page",
        "category": "Temco Learn"
      },
      {
        "command": "temcoLearn.site.clone",
        "title": "Clone temco-learn",
        "category": "Temco Learn"
      },
      {
        "command": "temcoLearn.site.useExisting",
        "title": "Use an Existing Clone",
        "category": "Temco Learn"
      },
      {
        "command": "temcoLearn.site.pull",
        "title": "Pull the Latest",
        "category": "Temco Learn"
      },
      {
        "command": "temcoLearn.site.terminal",
        "title": "Open a Terminal in the Site",
        "category": "Temco Learn"
      },
      {
        "command": "temcoLearn.site.clearLog",
        "title": "Clear the Site Log",
        "category": "Temco Learn"
      },
      {
        "command": "temcoLearn.site.showLog",
        "title": "Show the Full Site Log",
        "category": "Temco Learn"
      },
      {
        "command": "temcoLearn.site.remote",
        "title": "Open the Site Repository",
        "category": "Temco Learn"
      },
      {
        "command": "temcoLearn.publishNow",
        "title": "Publish Now",
        "category": "Temco Learn"
      },
      {
        "command": "temcoLearn.site.choose",
        "title": "Choose the Site Folder",
        "icon": "$(folder-library)",
        "category": "Temco Learn"
      },
      {
        "command": "temcoLearn.build",
        "title": "Build a Project…",
        "icon": "$(tools)",
        "category": "Temco Learn"
      },
      {
        "command": "temcoLearn.addBuild",
        "title": "Add This Build to the Site",
        "icon": "$(add)",
        "category": "Temco Learn"
      },
      {
        "command": "temcoLearn.addBuilds",
        "title": "Add a Build to the Site",
        "icon": "$(add)",
        "category": "Temco Learn"
      },
      {
        "command": "temcoLearn.publish",
        "title": "Publish",
        "icon": "$(cloud-upload)",
        "category": "Temco Learn"
      },
      {
        "command": "temcoLearn.openPublished",
        "title": "Open the Published Site",
        "icon": "$(globe)",
        "category": "Temco Learn"
      },
      {
        "command": "temcoLearn.refresh",
        "title": "Refresh",
        "icon": "$(refresh)",
        "category": "Temco Learn"
      },
      {
        "command": "temcoLearn.site.open",
        "title": "Open the Site in the Browser",
        "icon": "$(link-external)",
        "category": "Temco Learn"
      },
      {
        "command": "temcoLearn.previewArtifact",
        "title": "Look at This Build Output",
        "icon": "$(eye)",
        "category": "Temco Learn"
      },
      {
        "command": "temcoLearn.downloadArtifact",
        "title": "Save a Copy of This Build Output",
        "icon": "$(cloud-download)",
        "category": "Temco Learn"
      },
      {
        "command": "temcoLearn.revealArtifact",
        "title": "Show This Build Output in the Folder",
        "icon": "$(folder-opened)",
        "category": "Temco Learn"
      },
      {
        "command": "temcoLearn.publishing",
        "title": "Publishing",
        "icon": "$(cloud-upload)",
        "category": "Temco Learn"
      },
      {
        "command": "temcoLearn.downloads",
        "title": "Build Output",
        "icon": "$(cloud-download)",
        "category": "Temco Learn"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "temcoLearn.downloads",
          "when": "view == temcoLearn.download",
          "group": "navigation@1"
        },
        {
          "command": "temcoLearn.refresh",
          "when": "view == temcoLearn.overviewView",
          "group": "navigation@9"
        },
        {
          "command": "temcoLearn.refresh",
          "when": "view == temcoLearn.browse",
          "group": "navigation@9"
        },
        {
          "command": "temcoLearn.refresh",
          "when": "view == temcoLearn.download",
          "group": "navigation@9"
        },
        {
          "command": "temcoLearn.refresh",
          "when": "view == temcoLearn.todo",
          "group": "navigation@9"
        },
        {
          "command": "temcoLearn.overview",
          "when": "view == temcoLearn.overviewView",
          "group": "navigation@1"
        },
        {
          "command": "temcoLearn.build",
          "when": "view == temcoLearn.browse",
          "group": "navigation@1"
        },
        {
          "command": "temcoLearn.addBuilds",
          "when": "view == temcoLearn.browse",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "temcoLearn.previewArtifact",
          "when": "view == temcoLearn.download && viewItem == temcoLearn.artifact.look",
          "group": "inline@0"
        },
        {
          "command": "temcoLearn.downloadArtifact",
          "when": "view == temcoLearn.download && viewItem == temcoLearn.artifact",
          "group": "inline@1"
        },
        {
          "command": "temcoLearn.revealArtifact",
          "when": "view == temcoLearn.download && viewItem == temcoLearn.artifact",
          "group": "inline@2"
        }
      ]
    },
    "configuration": {
      "title": "Temco Learn",
      "properties": {
        "temcoLearn.siteRepo": {
          "type": "string",
          "default": "",
          "description": "The clone of the site repository (temcocontrols/temco-learn): React, Fluent UI and Markdown, built by Vite. Empty means `~/temco/temco-learn`."
        },
        "temcoLearn.sitePort": {
          "type": "number",
          "default": 1025,
          "minimum": 1025,
          "maximum": 65535,
          "description": "The port the site is served on, whether it is running the built pages or Vite. Above 1024, so it binds without root on macOS and Linux. A change takes effect the next time the server starts."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "check-commands": "node --experimental-strip-types scripts/check-commands.mts",
    "check-state": "node --experimental-strip-types scripts/check-state.mts",
    "check-publish": "node --experimental-strip-types scripts/check-publish.mts",
    "check-overview": "node --experimental-strip-types scripts/check-overview.mts",
    "check-artifacts": "node --experimental-strip-types scripts/check-artifacts.mts",
    "check-panel": "node --experimental-strip-types scripts/check-panel.mts",
    "check-preview": "node --experimental-strip-types scripts/check-preview.mts",
    "check-downloads": "node --experimental-strip-types scripts/check-downloads.mts"
  },
  "extensionDependencies": [
    "temcocontrols.temco-ui"
  ]
}
