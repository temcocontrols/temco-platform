        "shortTitle": "Detail",
        "category": "Temco Docs",
        "icon": "$(info)"
      },
      {
        "command": "temcoDocs.needsPage",
        "title": "Show the Queue",
        "icon": "$(tasklist)"
      },
      {
        "command": "temcoDocs.createProjectFolder",
