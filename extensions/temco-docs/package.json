{
  "name": "temco-docs",
  "displayName": "Temco Docs",
  "description": "Temco Docs — the documentation module of Temco Platform: keeps product documentation in step with the code, with a local AI drafting the updates.",
  "version": "0.0.1",
  "publisher": "temcocontrols",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/temcocontrols/temco-platform.git"
  },
  "bugs": {
    "url": "https://github.com/temcocontrols/temco-platform/issues"
  },
  "engines": {
    "vscode": "^1.143.0"
  },
  "type": "commonjs",
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "devDependencies": {
    "@univerjs/preset-sheets-core": "1.2.0",
    "@univerjs/presets": "1.2.0",
    "esbuild": "0.28.2",
    "typescript": "^5.9.3"
  },
  "extensionDependencies": [
    "temcocontrols.temco-store",
    "temcocontrols.temco-ui",
    "temcocontrols.temco-repositories",
    "temcocontrols.temco-projects"
  ],
  "activationEvents": [
    "onView:temcoDocs.panel",
    "onView:temcoDocs.pages",
    "onView:temcoDocs.queue",
    "onView:temcoDocs.forum",
    "onCustomEditor:temcoDocs.grid",
    "onView:temcoDocs.section.pipeline",
    "onWebviewPanel:temcoDocs.projects",
    "onWebviewPanel:temcoDocs.projectPage",
    "onWebviewPanel:temcoDocs.repository",
    "onWebviewPanel:temcoDocs.documents",
    "onWebviewPanel:temcoDocs.pagePanel",
    "onWebviewPanel:temcoDocs.source",
    "onWebviewPanel:temcoDocs.review",
    "onWebviewPanel:temcoDocs.exports",
    "onWebviewPanel:temcoDocs.registryPage",
    "onWebviewPanel:temcoDocs.builds",
    "onWebviewPanel:temcoDocs.releases",
    "onWebviewPanel:temcoDocs.overview"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "temcoDocs.grid",
        "displayName": "Temco Grid",
        "selector": [
          {
            "filenamePattern": "*.csv"
          },
          {
            "filenamePattern": "*.tsv"
          }
        ],
        "priority": "option"
      }
    ],
    "views": {
      "temco": [
        {
          "id": "temcoDocs.panel",
          "name": "Project",
          "type": "webview",
          "when": "temcoDocs.hasProject"
        },
        {
          "id": "temcoDocs.pages",
          "name": "Pages",
          "initialSize": 3
        },
        {
          "id": "temcoDocs.section.pipeline",
          "name": "Publish",
          "initialSize": 1,
          "visibility": "collapsed"
        }
      ],
      "temcoForum": [
        {
          "id": "temcoDocs.forum",
          "name": "Browse"
        }
      ]
    },
    "commands": [
      {
        "command": "temcoDocs.projects",
        "title": "Show the Projects",
        "icon": "$(layers)"
      },
      {
        "command": "temcoDocs.switchProject",
        "title": "Switch Project…",
        "icon": "$(folder)"
      },
      {
        "command": "temcoDocs.removeProject",
        "title": "Remove Project",
        "icon": "$(trash)"
      },
      {
        "command": "temcoDocs.projectPage",
