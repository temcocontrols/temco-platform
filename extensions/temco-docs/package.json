    "configuration": {
      "title": "Temco Docs",
      "properties": {
        "temcoDocs.translator.endpoint": {
          "type": "string",
          "default": "https://api.cognitive.microsofttranslator.com",
          "markdownDescription": "The endpoint of the Azure AI Translator resource used by **Temco Docs: Translate This Page**. The subscription key is not a setting: it is kept in the OS keychain by **Temco Docs: Set the Translator Key**."
        },
        "temcoDocs.translator.region": {
          "type": "string",
          "default": "",
          "markdownDescription": "The resource's region, for a regional Translator resource (for example `westeurope`). Leave empty for a global one, or when the key was made for a single region and the service accepts it without."
        },
        "temcoDocs.forumUrl": {
          "type": "string",
          "default": "https://forums.temcocontrols.com",
          "markdownDescription": "The community forum the **Forum** panel reads: a Discourse site. Its `site.json` lists the categories, each category's address lists its topics, and a topic's address carries the posts. Nothing is ever posted there from this window."
