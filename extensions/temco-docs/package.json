    "menus": {
      "explorer/context": [
        {
          "command": "temcoDocs.readSourceOfFile",
          "when": "resourceScheme == file",
          "group": "temcoDocs@1"
        },
        {
          "command": "temcoDocs.revealSourceOfFile",
          "when": "resourceScheme == file",
          "group": "temcoDocs@2"
        },
        {
          "command": "temcoDocs.findReferencesToFile",
          "when": "resourceScheme == file && resourceExtname == .md",
          "group": "temcoDocs@3"
        }
      ],
      "commandPalette": [
        {
          "command": "temcoDocs.readSourceOfFile",
          "when": "false"
        },
        {
          "command": "temcoDocs.revealSourceOfFile",
          "when": "false"
        },
        {
          "command": "temcoDocs.findReferencesToFile",
          "when": "false"
