{
  "name": "temco-tools",
  "displayName": "Temco Tools",
  "description": "Temco Tools — the device and data surfaces: Devices, I/O Studio, BACnet Studio, Network and SQL Studio.",
  "version": "0.0.1",
  "publisher": "temcocontrols",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/temcocontrols/temco-platform.git"
  },
  "bugs": {
    "url": "https://github.com/temcocontrols/temco-platform/issues"
  },
  "engines": {
    "vscode": "^1.143.0"
  },
  "type": "commonjs",
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "extensionDependencies": [
    "temcocontrols.temco-ui",
    "temcocontrols.temco-store"
  ],
  "activationEvents": [
    "onWebviewPanel:temcoTools.sql.query",
    "onWebviewPanel:temcoTools.sql.data",
    "onWebviewPanel:temcoTools.sql.reports",
    "onWebviewPanel:temcoTools.sql.saved",
    "onWebviewPanel:temcoTools.sql.history",
    "onWebviewPanel:temcoTools.sql.schema",
    "onWebviewPanel:temcoTools.sql.connections",
    "onView:temcoTools.studios"
  ],
  "contributes": {
    "views": {
      "temcoSql": [
        {
          "id": "temcoTools.studios",
          "name": "Studios"
        }
      ]
    },
    "commands": [
      {
        "command": "temcoTools.sql.query",
        "title": "Query Editor",
        "icon": "$(code)"
      },
      {
        "command": "temcoTools.sql.data",
        "title": "Data",
        "icon": "$(table)"
      },
      {
        "command": "temcoTools.sql.browse",
        "title": "Browse a Table",
        "icon": "$(table)"
      },
      {
        "command": "temcoTools.sql.page",
        "title": "Turn the Page"
      },
      {
        "command": "temcoTools.sql.connections",
        "title": "Database",
        "icon": "$(database)"
      },
      {
        "command": "temcoTools.sql.history",
        "title": "Query History",
        "icon": "$(history)"
      },
      {
        "command": "temcoTools.sql.schema",
        "title": "Schema",
        "icon": "$(list-unordered)"
      },
      {
        "command": "temcoTools.sql.saved",
        "title": "Saved Queries",
        "icon": "$(book)"
      },
      {
        "command": "temcoTools.sql.reports",
        "title": "Query Presets",
        "icon": "$(graph)"
      },
      {
        "command": "temcoTools.sql.run",
        "title": "Run the Query (Read Only)"
      },
      {
        "command": "temcoTools.sql.runWrite",
        "title": "Run the Query (Allow Writes)"
      },
      {
        "command": "temcoTools.sql.saveQuery",
        "title": "Save the Query"
      },
      {
        "command": "temcoTools.sql.export",
        "title": "Export the Result as CSV",
        "icon": "$(download)"
      },
      {
        "command": "temcoTools.sql.copySql",
        "title": "Copy the Statement",
        "icon": "$(copy)"
      },
      {
        "command": "temcoTools.sql.copyResult",
        "title": "Copy the Rows as Text",
        "icon": "$(table)"
      },
      {
        "command": "temcoTools.sql.recall",
        "title": "Load a Statement Back into the Editor"
      },
      {
        "command": "temcoTools.sql.queryTable",
        "title": "Query This Table"
      },
      {
        "command": "temcoTools.sql.loadSaved",
        "title": "Load a Saved Query"
      },
      {
        "command": "temcoTools.sql.deleteSaved",
        "title": "Delete a Saved Query"
      },
      {
        "command": "temcoTools.sql.loadPreset",
        "title": "Load a Preset"
      },
      {
        "command": "temcoTools.sql.refreshSchema",
        "title": "Refresh the Schema"
      },
      {
        "command": "temcoTools.sql.selectTable",
        "title": "Open a Table's Schema"
      },
      {
        "command": "temcoTools.sql.copyDdl",
        "title": "Copy a Table's Statement"
      },
      {
        "command": "temcoTools.sql.integrity",
        "title": "Check the Database's Integrity",
        "icon": "$(check)"
      },
      {
        "command": "temcoTools.sql.clearHistory",
        "title": "Clear the Query History"
      },
      {
        "command": "temcoTools.sql.openFolder",
        "title": "Show the Database File"
      },
      {
        "command": "temcoTools.sql.copyPath",
        "title": "Copy the Database Path"
      },
      {
        "command": "temcoTools.sql.vacuum",
        "title": "Vacuum the Database"
      },
      {
        "command": "temcoTools.sql.checkpoint",
        "title": "Checkpoint the Write-Ahead Log"
      },
      {
        "command": "temcoTools.sql.backup",
        "title": "Back Up the Database"
      },
      {
        "command": "temcoTools.sql.clear",
        "title": "Empty Every Table"
      },
      {
        "command": "temcoTools.sql.reset",
        "title": "Reset the Database"
      }
    ]
  }
}
