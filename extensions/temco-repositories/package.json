{
  "name": "temco-repositories",
  "displayName": "Temco Repositories",
  "description": "Temco Repositories — the organisation and its clones: the repository list, the working area, and reading a source into the platform's memory.",
  "version": "0.0.1",
  "publisher": "temcocontrols",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/temcocontrols/temco-platform.git"
  },
  "bugs": {
    "url": "https://github.com/temcocontrols/temco-platform/issues"
  },
  "engines": {
    "vscode": "^1.143.0"
  },
  "type": "commonjs",
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "extensionDependencies": [
    "temcocontrols.temco-store",
    "temcocontrols.temco-ui"
  ],
  "activationEvents": [
    "onView:temcoRepositories.list",
    "onWebviewPanel:temcoRepositories.page",
    "onWebviewPanel:temcoRepositories.repositoryDetail",
    "onWebviewPanel:temcoRepositories.settings",
    "onWebviewPanel:temcoRepositories.dashboard"
  ],
  "contributes": {
    "views": {
      "temcoRepositories": [
        {
          "id": "temcoRepositories.list",
          "name": "Sources"
        }
      ]
    },
    "commands": [
      {
        "command": "temcoRepositories.page",
        "title": "The Repositories",
        "icon": "$(github)"
      },
      {
        "command": "temcoRepositories.repository",
        "title": "Open a Repository"
      },
      {
        "command": "temcoRepositories.repositoryClone",
        "title": "Clone This Repository on Its Page"
      },
      {
        "command": "temcoRepositories.repositoryPull",
        "title": "Pull This Repository on Its Page"
      },
      {
        "command": "temcoRepositories.revealInTree",
        "title": "View This Repository in the Panel",
        "icon": "$(repo)"
      },
      {
        "command": "temcoRepositories.rowFetch",
        "title": "Clone This Repository",
        "icon": "$(cloud-download)"
      },
      {
        "command": "temcoRepositories.rowProject",
        "title": "Create a Project from This Repository",
        "icon": "$(new-folder)"
      },
      {
        "command": "temcoRepositories.settings",
        "title": "Repository Settings",
        "icon": "$(gear)"
      },
      {
        "command": "temcoRepositories.dashboard",
        "title": "Repositories — Dashboard",
        "icon": "$(dashboard)"
      },
      {
        "command": "temcoRepositories.applyToSource",
        "title": "Apply a Change to a Clone",
        "category": "Temco Repositories",
        "icon": "$(git-commit)"
      },
      {
        "command": "temcoRepositories.rowReadOrg",
        "title": "Read This Enterprise Again",
        "icon": "$(refresh)"
      },
      {
        "command": "temcoRepositories.rowForgetOrg",
        "title": "Forget This Enterprise",
        "icon": "$(trash)"
      },
      {
        "command": "temcoRepositories.readSource",
        "title": "Read a Source",
        "icon": "$(cloud-download)"
      },
      {
        "command": "temcoRepositories.readAllSources",
        "title": "Read Every Source",
        "icon": "$(cloud-download)"
      },
      {
        "command": "temcoRepositories.removeSource",
        "title": "Forget the Source",
        "icon": "$(trash)"
      },
      {
        "command": "temcoRepositories.revealSource",
        "title": "Open the Source",
        "icon": "$(link-external)"
      },
      {
        "command": "temcoRepositories.setSourceBranch",
        "title": "Set the Branch to Read",
        "icon": "$(git-branch)"
      },
      {
        "command": "temcoRepositories.openFile",
        "title": "Open the File",
        "icon": "$(go-to-file)"
      },
      {
        "command": "temcoRepositories.setToken",
        "title": "Set a GitHub Token",
        "icon": "$(key)"
      },
      {
        "command": "temcoRepositories.fetchSource",
        "title": "Clone the Source",
        "icon": "$(repo-clone)"
      },
      {
        "command": "temcoRepositories.pullSource",
        "title": "Pull the Source",
        "icon": "$(repo-pull)"
      },
      {
        "command": "temcoRepositories.openClone",
        "title": "Open the Clone",
        "icon": "$(folder-opened)"
      },
      {
        "command": "temcoRepositories.showInExplorer",
        "title": "Show in Explorer",
        "icon": "$(list-tree)"
      },
      {
        "command": "temcoRepositories.hideFromExplorer",
        "title": "Hide from Explorer",
        "icon": "$(close)"
      },
      {
        "command": "temcoRepositories.removeClone",
        "title": "Remove the Clone",
        "icon": "$(trash)"
      },
      {
        "command": "temcoRepositories.changeWorkspaceFolder",
        "title": "Change the Working Area",
        "icon": "$(file-directory)"
      },
      {
        "command": "temcoRepositories.openWorkFolder",
        "title": "Open the Working Area",
        "icon": "$(folder-opened)"
      },
      {
        "command": "temcoRepositories.showLog",
        "title": "Show the Log",
        "icon": "$(output)"
      },
      {
        "command": "temcoRepositories.moveClones",
        "title": "Move the Clones Into the Shared Folder",
        "icon": "$(folder-library)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "temcoRepositories.dashboard",
          "when": "view == temcoRepositories.list",
          "group": "navigation@0"
        },
        {
          "command": "temcoRepositories.page",
          "when": "view == temcoRepositories.list",
          "group": "navigation@1"
        },
        {
          "command": "temcoRepositories.readAllSources",
          "when": "view == temcoRepositories.list",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "temcoRepositories.rowReadOrg",
          "when": "view == temcoRepositories.list && viewItem == temcoOrganisation",
          "group": "inline@0"
        },
        {
          "command": "temcoRepositories.rowForgetOrg",
          "when": "view == temcoRepositories.list && viewItem == temcoOrganisation",
          "group": "1_actions@0"
        },
        {
          "command": "temcoRepositories.rowFetch",
          "when": "view == temcoRepositories.list && viewItem == temcoRepository",
          "group": "inline@0"
        },
        {
          "command": "temcoRepositories.rowProject",
          "when": "view == temcoRepositories.list && viewItem == temcoRepository",
          "group": "inline@1"
        },
        {
          "command": "temcoRepositories.readSource",
          "when": "view == temcoRepositories.list && viewItem == temcoSource",
          "group": "inline@0"
        },
        {
          "command": "temcoRepositories.revealSource",
          "when": "view == temcoRepositories.list && viewItem == temcoSource",
          "group": "inline@1"
        },
        {
          "command": "temcoRepositories.pullSource",
          "when": "view == temcoRepositories.list && viewItem == temcoSource",
          "group": "1_copy@0"
        },
        {
          "command": "temcoRepositories.openClone",
          "when": "view == temcoRepositories.list && viewItem == temcoSource",
          "group": "1_copy@1"
        },
        {
          "command": "temcoRepositories.showInExplorer",
          "when": "view == temcoRepositories.list && viewItem == temcoSource",
          "group": "1_copy@2"
        },
        {
          "command": "temcoRepositories.hideFromExplorer",
          "when": "view == temcoRepositories.list && viewItem == temcoSource",
          "group": "1_copy@3"
        },
        {
          "command": "temcoRepositories.removeSource",
          "when": "view == temcoRepositories.list && viewItem == temcoSource",
          "group": "9_forget@0"
        }
      ]
    },
    "configuration": {
      "title": "Temco Repositories",
      "properties": {
        "temcoRepositories.organisation": {
          "type": "string",
          "default": "temcocontrols",
          "markdownDescription": "The enterprise the Repositories page opens on, and writes into the platform's database the first time the page opens. Every other enterprise is added on the page itself."
        },
        "temcoRepositories.workspaceFolder": {
          "type": "string",
          "default": "",
          "markdownDescription": "The working area: where clones of sources are made (`source/` under it), and where a project's folder is written unless `#temcoRepositories.projectsFolder#` says otherwise. Empty means `~/temco`. It is outside every repository on purpose: **nothing is ever written to a source, and nothing is ever pushed**."
        },
        "temcoRepositories.projectsFolder": {
          "type": "string",
          "default": "",
          "markdownDescription": "Where a project's own folder is made — `<this>/<slug>`, holding its `docs/`, its build and what it produces. Empty means the working area above, which is how every project was placed before this setting existed. Point it at a folder of its own (`~/temco/projects`) to keep projects apart from the shared clones."
        }
      }
    }
  },
  "scripts": {
    "check-commands": "node --experimental-strip-types scripts/check-commands.mts"
  }
}
