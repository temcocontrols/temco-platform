{
  "name": "temco-workbench",
  "displayName": "Temco Workbench",
  "description": "Temco Workbench — the application's own surfaces: the Library that lists what every module has, the dashboard, and what needs doing.",
  "version": "0.0.1",
  "publisher": "temcocontrols",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/temcocontrols/temco-platform.git"
  },
  "bugs": {
    "url": "https://github.com/temcocontrols/temco-platform/issues"
  },
  "engines": {
    "vscode": "^1.143.0"
  },
  "type": "commonjs",
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "extensionDependencies": [
    "temcocontrols.temco-store",
    "temcocontrols.temco-ui",
    "temcocontrols.temco-repositories",
    "temcocontrols.temco-docs"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:temcoWorkbench.overviewView",
    "onView:temcoWorkbench.settings",
    "onView:temcoLearn.panel",
    "onWebviewPanel:temcoWorkbench.overview",
    "onWebviewPanel:temcoWorkbench.activity",
    "onWebviewPanel:temcoWorkbench.settings.general",
    "onWebviewPanel:temcoWorkbench.settings.modules",
    "onWebviewPanel:temcoWorkbench.settings.branding",
    "onWebviewPanel:temcoWorkbench.settings.ai",
    "onWebviewPanel:temcoWorkbench.settings.publishing",
    "onWebviewPanel:temcoWorkbench.help.welcome",
    "onWebviewPanel:temcoWorkbench.help.home",
    "onWebviewPanel:temcoWorkbench.help.keys",
    "onWebviewPanel:temcoWorkbench.help.logs",
    "onWebviewPanel:temcoWorkbench.help.issue",
    "onWebviewPanel:temcoWorkbench.help.about",
    "onWebviewPanel:temcoWorkbench.learn.home",
    "onWebviewPanel:temcoWorkbench.learn.article",
    "onWebviewPanel:temcoWorkbench.learn.downloads"
  ],
  "contributes": {
    "configurationDefaults": {
      "window.commandCenter": false
    },
    "views": {
      "temcoDashboard": [
        {
          "id": "temcoWorkbench.overviewView",
          "name": "Overview",
          "initialSize": 5
        },
        {
          "id": "temcoProjects.projects",
          "name": "Projects"
        },
        {
          "id": "temcoDocs.queue",
          "name": "What needs doing",
          "initialSize": 1
        }
      ],
      "temcoSettings": [
        {
          "id": "temcoWorkbench.settings",
          "name": "Settings",
          "initialSize": 6
        }
      ]
    },
    "commands": [
      {
        "command": "temcoWorkbench.learn.home",
        "title": "Temco Learn",
        "icon": "$(home)"
      },
      {
        "command": "temcoWorkbench.learn.article",
        "title": "Article Preview",
        "icon": "$(document)"
      },
      {
        "command": "temcoWorkbench.learn.downloads",
        "title": "Downloads",
        "icon": "$(cloud-download)"
      },
      {
        "command": "temcoWorkbench.home",
        "title": "Home",
        "icon": "$(home)"
      },
      {
        "command": "temcoWorkbench.welcome",
        "title": "Welcome",
        "icon": "$(dashboard)"
      },
      {
        "command": "temcoWorkbench.toggleWelcomeStartup",
        "title": "Open the Welcome Page at Startup"
      },
      {
        "command": "temcoWorkbench.settings",
        "title": "Settings",
        "icon": "$(gear)"
      },
      {
        "command": "temcoWorkbench.settings.general",
        "title": "General",
        "icon": "$(gear)"
      },
      {
        "command": "temcoWorkbench.settings.modules",
        "title": "Modules",
        "icon": "$(package)"
      },
      {
        "command": "temcoWorkbench.settings.branding",
        "title": "Branding",
        "icon": "$(paintcan)"
      },
      {
        "command": "temcoWorkbench.settings.ai",
        "title": "AI Runtime",
        "icon": "$(sparkle)"
      },
      {
        "command": "temcoWorkbench.settings.publishing",
        "title": "Publishing",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "temcoWorkbench.settings.reset",
        "title": "Restore the General Settings to Their Defaults"
      },
      {
        "command": "temcoWorkbench.settings.showOnDisk",
        "title": "Show the Modules on Disk",
        "icon": "$(folder)"
      },
      {
        "command": "temcoWorkbench.settings.checkUpdates",
        "title": "Check the Platform for Updates",
        "icon": "$(refresh)"
      },
      {
        "command": "temcoWorkbench.settings.replaceIcon",
        "title": "Replace the Application Mark"
      },
      {
        "command": "temcoWorkbench.settings.resetBranding",
        "title": "Reset the Identity"
      },
      {
        "command": "temcoWorkbench.settings.testPublish",
        "title": "Test the Publish Target"
      },
      {
        "command": "temcoWorkbench.copyLogPath",
        "title": "Copy Log Folder Path"
      },
      {
        "command": "temcoWorkbench.copyDiagnostics",
        "title": "Copy Diagnostics"
      },
      {
        "command": "temcoWorkbench.setStartOpen",
        "title": "Set What Opens at Startup"
      },
      {
        "command": "temcoWorkbench.help",
        "title": "Help",
        "icon": "$(question)"
      },
      {
        "command": "temcoWorkbench.help.welcome",
        "title": "Welcome",
        "icon": "$(dashboard)"
      },
      {
        "command": "temcoWorkbench.help.home",
        "title": "Help",
        "icon": "$(info)"
      },
      {
        "command": "temcoWorkbench.help.keys",
        "title": "Keyboard Shortcuts",
        "icon": "$(keyboard)"
      },
      {
        "command": "temcoWorkbench.help.logs",
        "title": "Logs",
        "icon": "$(output)"
      },
      {
        "command": "temcoWorkbench.help.issue",
        "title": "Report an Issue",
        "icon": "$(report)"
      },
      {
        "command": "temcoWorkbench.help.about",
        "title": "About Temco Platform",
        "icon": "$(info)"
      },
      {
        "command": "temcoWorkbench.help.openLog",
        "title": "Open a Log File"
      },
      {
        "command": "temcoWorkbench.help.copyReport",
        "title": "Copy the Report and Open the Issue Reporter"
      },
      {
        "command": "temcoWorkbench.overview",
        "title": "Overview",
        "icon": "$(home)"
      },
      {
        "command": "temcoWorkbench.activity",
        "title": "Recent Activity",
        "icon": "$(history)"
      }
    ],
    "configuration": {
      "title": "Temco Workbench",
      "properties": {
        "temcoWorkbench.start.open": {
          "type": "string",
          "enum": [
            "welcome",
            "project",
            "page",
            "home",
            "none"
          ],
          "enumDescriptions": [
            "The welcome page — what the application is for, and the six things to do first. This is the default, and its footer checkbox writes this same setting.",
            "The project being worked on: its pages. With no project, the page you were last on.",
            "The page you were last working on in the project being worked on. With none, that project's pages.",
            "The platform's overview — what it holds and what needs a person. Reached from the Dashboard too.",
            "Nothing — no tab opens by itself."
          ],
          "default": "welcome",
          "markdownDescription": "What opens in the editor when the extension is activated — the one decision that makes a first tab. Each choice falls through to the next when it cannot be honoured: `project`, then the page you were last on, then the overview. With the welcome page switched off, that chain never ends at the welcome page. Only `none` opens nothing."
        },
        "temcoWorkbench.start.panel": {
          "type": "string",
          "default": "temcoDashboard",
          "markdownDescription": "The side panel the window opens with — an id from the left panel, as `viewsContainers.activitybar` declares it (for example `temcoDashboard`). The Settings page lists them by title rather than by id. An id this build does not have reveals nothing, and the window starts as it otherwise would."
        },
        "temcoWorkbench.updateChannel": {
          "type": "string",
          "enum": [
            "Stable",
            "Preview"
          ],
          "enumDescriptions": [
            "The release readers get.",
            "Release candidates, one version earlier than Stable."
          ],
          "default": "Stable",
          "description": "Which channel a new version of the platform comes from. The channel is read when the window checks for updates; a change takes effect on restart."
        },
        "temcoWorkbench.branding.productName": {
          "type": "string",
          "default": "Temco Platform",
          "description": "The name this profile draws for itself — the welcome page's title and the studio line above every page of ours."
        },
        "temcoWorkbench.branding.accent": {
          "type": "string",
          "default": "#0078d4",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "patternErrorMessage": "A six-digit hex colour, for example #0078d4.",
          "markdownDescription": "The accent this profile draws with. Setting it writes the platform's colour roles into `#workbench.colorCustomizations#` — focus, primary buttons, badges, links and progress — so the window itself changes rather than a sample on a page. Clearing it puts back whatever was there before."
        },
        "temcoWorkbench.publishing.site": {
          "type": "string",
          "default": "https://learn.temcocontrols.com",
          "description": "The address a release is published to."
        },
        "temcoWorkbench.publishing.path": {
          "type": "string",
          "default": "/t3000/{version}/",
          "description": "The path under that address a version is written to. `{version}` is replaced by the version being published."
        },
        "temcoWorkbench.publishing.channel": {
          "type": "string",
          "enum": [
            "Stable",
            "Preview"
          ],
          "enumDescriptions": [
            "The release readers get, indexed by search engines.",
            "Published with noindex, so a search engine never sees a draft."
          ],
          "default": "Stable",
          "description": "Which channel a release goes out on."
        },
        "temcoWorkbench.publishing.website": {
          "type": "boolean",
          "default": true,
          "description": "Publish the rendered site."
        },
        "temcoWorkbench.publishing.pdf": {
          "type": "boolean",
          "default": true,
          "description": "Publish one PDF per version, built from the same pages."
        },
        "temcoWorkbench.publishing.offlineHelp": {
          "type": "boolean",
          "default": true,
          "description": "Publish the Windows help file readers open from the Start menu."
        },
        "temcoWorkbench.publishing.searchIndex": {
          "type": "boolean",
          "default": true,
          "description": "Publish the static index the site loads to answer a search."
        },
        "temcoWorkbench.publishing.aiIndex": {
          "type": "boolean",
          "default": false,
          "description": "Publish local chunks for the AI panel. Never uploaded with the site."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "temcoDashboard",
          "title": "Home",
          "icon": "media/dashboard.svg"
        },
        {
          "id": "temco",
          "title": "Documentation",
          "icon": "media/document.svg"
        },
        {
          "id": "temcoRepositories",
          "title": "Repositories",
          "icon": "media/repositories.svg"
        },
        {
          "id": "temcoAiHub",
          "title": "AI",
          "icon": "media/ai.svg"
        },
        {
          "id": "temcoForum",
          "title": "Forum",
          "icon": "media/forum.svg"
        },
        {
          "id": "temcoSql",
          "title": "Tools",
          "icon": "media/sql.svg"
        },
        {
          "id": "temcoSettings",
          "title": "Settings",
          "icon": "media/settings.svg"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "temcoWorkbench.overview",
          "when": "view == temcoProjects.projects",
          "group": "navigation",
          "title": "Overview"
        },
        {
          "command": "temcoWorkbench.overview",
          "when": "view == temcoWorkbench.overviewView",
          "group": "navigation",
          "title": "Overview"
        }
      ]
    }
  },
  "scripts": {
    "check-commands": "node --experimental-strip-types scripts/check-commands.mts",
    "check-types": "node node_modules/typescript/bin/tsc -p tsconfig.webview.json",
    "build-webview": "node --experimental-strip-types scripts/build-webview.mts",
    "vscode:prepublish": "npm run check-commands && npm run check-types && npm run build-webview"
  },
  "devDependencies": {
    "@fluentui/react-components": "^9.75.0",
    "@fluentui/react-icons": "^2.0.344",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3"
  }
}
